# Copy to .env (git-ignored). Secrets only live in .env.

# --- Paperless
# Address you open Paperless at. On a server behind Tailscale:
#   PAPERLESS_URL=https://vps.tailnet-name.ts.net
#   PAPERLESS_ALLOWED_HOSTS=localhost,paperless,vps.tailnet-name.ts.net
PAPERLESS_URL=http://localhost:8000
PAPERLESS_ALLOWED_HOSTS=localhost,paperless
# Absolute path of the folder Paperless watches for new files
CONSUME_DIR=/absolute/path/to/paperless-local/consume
POSTGRES_PASSWORD=change-me
PAPERLESS_SECRET_KEY=change-me-long-random
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me
# created after first start: see README "Paperless API token"
PAPERLESS_API_TOKEN=

# Options of the "Paid by" custom field (read by setup.py)
PAID_BY=Company,Alice,Bob

# --- Claude (paperless-ai)
ANTHROPIC_API_KEY=

# --- Mail (read by setup.py; stored in Paperless's DB)
# Mail ingest, option A: Microsoft 365 / Outlook (OAuth).
# 1. Entra app registration (multitenant), redirect URI ${PAPERLESS_URL}/api/oauth/callback/
# 2. fill the two values below, docker compose up -d
# 3. Paperless > Mail > Add account > Connect with Outlook (as a user with access to the mailbox)
# 4. MAIL_ACCOUNT = the mailbox address shown in Paperless, then: python3 setup.py
OUTLOOK_OAUTH_CLIENT_ID=
OUTLOOK_OAUTH_CLIENT_SECRET=
MAIL_ACCOUNT=
# Mail ingest, option B: plain IMAP with a password (Gmail app password, Fastmail...).
MAIL_IMAP_SERVER=
MAIL_IMAP_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
